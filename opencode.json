{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {},
  "mcp": {
    "zai-vision": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server"],
      "timeout": 120000,
      "environment": {
        "Z_AI_API_KEY": "{env:Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-mem@latest"
  ],
  "provider": {
    "zai-coding-plan": {
      "models": {
        "glm-5.2": {
          "variants": {
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        }
      }
    }
  }
}
